{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipWeave",
  "version": "0.1.0",
  "identifier": "dev.clipweave.m1",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipWeave \u00b7 M1",
        "width": 780,
        "height": 680,
        "minWidth": 620,
        "minHeight": 520
      },
      {
        "label": "overlay",
        "title": "ClipWeave \uac00\uacf5 \uba54\ub274",
        "url": "index.html?overlay",
        "width": 440,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "15.5"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
