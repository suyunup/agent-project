# Public template: never put real credentials in this file.
# Development-only backend configuration; loaded by the Rust backend at startup.
# Do not prefix secrets with VITE_ or expose them to the frontend.
CLIPWEAVE_AI_PROVIDER=ollama
CLIPWEAVE_AI_TIMEOUT_SECONDS=60
CLIPWEAVE_OLLAMA_BASE_URL=http://127.0.0.1:11434
CLIPWEAVE_OLLAMA_MODEL=qwen3:0.6b
CLIPWEAVE_OPENAI_BASE_URL=https://api.openai.com/v1
CLIPWEAVE_OPENAI_MODEL=gpt-5-mini
CLIPWEAVE_OPENAI_API_KEY=
CLIPWEAVE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CLIPWEAVE_GEMINI_MODEL=gemini-3.8-flash
CLIPWEAVE_GEMINI_API_KEY=
